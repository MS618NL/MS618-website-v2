---
import { getLangFromUrl, getAlternatePath, useTranslations } from '@/i18n';
import { getCollection } from 'astro:content';

interface Props {
  url?: URL;
  /** Override for the language-toggle target (e.g. when no translation of this page exists). */
  altPath?: string;
}

const url = Astro.props.url ?? Astro.url;
const lang = getLangFromUrl(url);
const t = useTranslations(lang);
const altLang = lang === 'nl' ? 'en' : 'nl';
const altPath = Astro.props.altPath ?? getAlternatePath(url, altLang);
const prefix = lang === 'en' ? '/en' : '';
const homeHref = lang === 'en' ? '/en/' : '/';

const servicesHref = lang === 'en' ? '/en/services/' : '/diensten/';

const navItems: { label: string; href: string; mega?: boolean }[] = [
  { label: t('nav.services'), href: servicesHref, mega: true },
  { label: t('nav.cases'), href: `${prefix}/cases/` },
  { label: t('nav.blog'), href: `${prefix}/blog/` },
  { label: t('nav.about'), href: lang === 'en' ? '/en/about/' : '/over-ons/' },
  { label: 'Contact', href: `${prefix}/contact/` },
];
const contactHref = `${prefix}/contact/`;

// Megamenu: de diensten zelf plus het proces, één bron met de dienstenpagina.
const megaServices = (await getCollection(lang === 'en' ? 'services-en' : 'services'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((s) => ({ title: s.data.title, icon: s.data.icon, href: `${servicesHref}${s.id}/` }));

const megaSteps = lang === 'en'
  ? ['Strategy & AI implementation', 'Visibility & findability', 'Websites, design & brand experience', 'Content & communication', 'Growth & optimization']
  : ['Strategie & AI-implementatie', 'Zichtbaarheid & vindbaarheid', 'Websites, design & merkbeleving', 'Content & communicatie', 'Groei & optimalisatie'];
---

<header class="site-header" id="site-header">
  <div class="header-bar">
    <div class="container header-inner">
      <a href={homeHref} class="logo" aria-label="MS618 — Home">
        <span class="logo-text">MS618</span>
      </a>

      <nav class="main-nav" aria-label={lang === 'en' ? 'Main navigation' : 'Hoofdnavigatie'}>
        <ul>
          {navItems.map((item) => (
            item.mega ? (
              <li class="has-mega">
                <a href={item.href} class="nav-link nav-link-mega">
                  {item.label}
                  <svg class="mega-chevron" width="10" height="10" viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
                <div class="mega-panel">
                  <div class="mega-inner">
                    <div class="mega-col">
                      <span class="mega-label">{lang === 'en' ? 'Services' : 'Diensten'}</span>
                      <ul class="mega-services">
                        {megaServices.map((s) => (
                          <li>
                            <a href={s.href}>
                              <span class="mega-icon" aria-hidden="true">{s.icon}</span>
                              <span>{s.title}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div class="mega-col mega-col-process">
                      <span class="mega-label">{lang === 'en' ? 'Our approach' : 'Onze aanpak'}</span>
                      <ol class="mega-steps">
                        {megaSteps.map((step, i) => (
                          <li><span class="mega-num">{String(i + 1).padStart(2, '0')}</span>{step}</li>
                        ))}
                      </ol>
                      <a href={item.href} class="mega-all">
                        {lang === 'en' ? 'All services' : 'Alle diensten'} →
                      </a>
                    </div>
                  </div>
                </div>
              </li>
            ) : (
              <li>
                <a href={item.href} class="nav-link">{item.label}</a>
              </li>
            )
          ))}
        </ul>
      </nav>

      <div class="header-actions">
        <a href={altPath} class="lang-toggle" aria-label={`Switch to ${altLang.toUpperCase()}`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          {altLang.toUpperCase()}
        </a>
        <a href={contactHref} class="btn-primary header-cta">{t('nav.cta')}</a>
      </div>

      <button class="mobile-menu-toggle" id="mobile-toggle" aria-label={lang === 'en' ? 'Open menu' : 'Menu openen'} aria-expanded="false">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav">
    <nav aria-label={lang === 'en' ? 'Mobile navigation' : 'Mobiele navigatie'}>
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="mobile-nav-link">{item.label}</a>
          </li>
        ))}
        <li><a href={contactHref} class="mobile-nav-link mobile-cta">{t('nav.cta')} →</a></li>
        <li>
          <a href={altPath} class="mobile-nav-link lang-mobile">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            {altLang.toUpperCase()}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* ── Fixed header shell ── */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 100;
  }

  /* ── Top bar (always visible) ── */
  .header-bar {
    background: transparent;
    border-bottom: none;
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .site-header.scrolled .header-bar {
    background: rgba(10, 10, 10, 0.95);
    border-bottom: 1px solid #222;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 4rem;
  }

  .logo {
    flex-shrink: 0;
    text-decoration: none;
  }

  .logo-text {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fafafa;
  }

  .main-nav {
    flex: 1;
  }

  /* Alleen de directe navigatielijst is horizontaal; lijsten in de megamenu niet. */
  .main-nav > ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: block;
    padding: 0.4rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 400;
    color: #a3a3a3;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .nav-link:hover {
    opacity: 0.7;
  }

  /* ── Megamenu onder Diensten ── */
  .has-mega {
    position: relative;
  }

  .nav-link-mega {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .mega-chevron {
    opacity: 0.55;
    transition: transform 0.2s ease;
  }

  .mega-panel {
    position: absolute;
    top: 100%;
    left: 0;
    /* transparante brug, zodat de muis van link naar paneel kan zonder te sluiten */
    padding-top: 0.75rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
  }

  .has-mega:hover .mega-panel,
  .has-mega:focus-within .mega-panel {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
  }

  .has-mega:hover .mega-chevron,
  .has-mega:focus-within .mega-chevron {
    transform: rotate(180deg);
  }

  .mega-inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 2rem;
    width: 660px;
    padding: 1.75rem;
    background: rgba(10, 10, 10, 0.98);
    border: 1px solid #222;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  /* voorkomt dat lange dienstnamen de kolombreedte oprekken */
  .mega-col {
    min-width: 0;
  }

  .mega-label {
    display: block;
    margin-bottom: 0.9rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #666;
  }

  .mega-services {
    display: block;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mega-services a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.32rem 0;
    font-size: 0.8125rem;
    color: #a3a3a3;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .mega-services a:hover {
    color: #fafafa;
  }

  .mega-icon {
    flex-shrink: 0;
    width: 0.9rem;
    color: oklch(0.65 0.2 250);
  }

  .mega-col-process {
    border-left: 1px solid #1c1c1c;
    padding-left: 2rem;
  }

  .mega-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mega-steps li {
    display: flex;
    align-items: baseline;
    padding: 0.32rem 0;
    font-size: 0.8125rem;
    color: #a3a3a3;
  }

  .mega-num {
    flex-shrink: 0;
    margin-right: 0.6rem;
    font-size: 0.6875rem;
    color: #555;
    font-variant-numeric: tabular-nums;
  }

  .mega-all {
    display: inline-block;
    margin-top: 1.1rem;
    padding-bottom: 2px;
    font-size: 0.8125rem;
    color: #fafafa;
    text-decoration: none;
    border-bottom: 1px solid #333;
    transition: border-color 0.2s ease;
  }

  .mega-all:hover {
    border-color: #fafafa;
  }

  @media (prefers-reduced-motion: reduce) {
    .mega-panel,
    .mega-chevron {
      transition: none;
    }
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #a3a3a3;
    text-decoration: none;
    border: 1px solid #333;
    transition: opacity 0.2s ease;
  }

  .lang-toggle:hover {
    opacity: 0.7;
  }

  .header-cta {
    flex-shrink: 0;
    padding: 0.75rem 1.5rem;
    font-size: 0.875rem;
    background: #fafafa !important;
    color: #0a0a0a !important;
    border: none !important;
  }

  .header-cta:hover {
    opacity: 0.9;
    background: #fafafa !important;
    color: #0a0a0a !important;
  }

  /* ── Hamburger (hidden on desktop) ── */
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.75rem;
    margin-left: auto;
    min-width: 44px;
    min-height: 44px;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-menu-toggle .bar {
    display: block;
    width: 20px;
    height: 2px;
    background: #fafafa;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  /* Animate to X when open */
  .mobile-menu-toggle.active .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile-menu-toggle.active .bar:nth-child(2) {
    opacity: 0;
  }
  .mobile-menu-toggle.active .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Mobile nav panel (hidden on desktop) ── */
  .mobile-nav {
    display: none;
    background: rgba(10, 10, 10, 0.98);
    border-top: 1px solid #222;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .mobile-nav.open {
    display: block;
    max-height: 100vh;
  }

  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 1rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.875rem 0;
    font-size: 1rem;
    font-weight: 500;
    color: #999;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: color 0.2s ease;
  }

  .mobile-nav-link:hover,
  .mobile-cta {
    color: #fafafa;
  }

  .lang-mobile {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #999999 !important;
    font-size: 0.875rem;
    border-bottom: none;
  }

  /* ── Desktop: top offset for floating effect ── */
  @media (min-width: 769px) {
    .site-header {
      top: 2rem;
    }

    .mobile-menu-toggle,
    .mobile-nav {
      display: none !important;
    }
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .header-inner {
      height: 3.5rem;
    }

    .logo-text {
      font-size: 1.25rem;
    }

    .main-nav,
    .header-actions,
    .mega-panel {
      display: none;
    }

    .mobile-menu-toggle {
      display: flex;
    }

    /* Always show background on mobile for readability */
    .header-bar {
      background: rgba(10, 10, 10, 0.95);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }

    .mobile-nav ul {
      padding: 0.75rem 1rem 1rem;
    }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const header = document.getElementById('site-header');

  if (toggle && mobileNav) {
    toggle.addEventListener('click', () => {
      const isOpen = mobileNav.classList.contains('open');

      if (isOpen) {
        // Close
        mobileNav.classList.remove('open');
        toggle.classList.remove('active');
        toggle.setAttribute('aria-expanded', 'false');
        mobileNav.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      } else {
        // Open
        mobileNav.classList.add('open');
        toggle.classList.add('active');
        toggle.setAttribute('aria-expanded', 'true');
        mobileNav.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
    });

    // Close on link click
    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileNav.classList.remove('open');
        toggle.classList.remove('active');
        toggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      });
    });
  }

  // Scroll detection for transparent → blur nav
  function handleScroll() {
    if (window.scrollY > 50) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
</script>
