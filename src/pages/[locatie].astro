---
import Page from '@/layouts/Page.astro';
import CTA from '@/components/CTA.astro';
import { getCollection, render } from 'astro:content';
import { buildLocalBusinessPiece, buildFaqPiece } from '@/utils/schema';
import { canonicalUrl } from '@/utils/seo';
import site from '@/data/site.json';

export async function getStaticPaths() {
  const pages = await getCollection('local');
  return pages.map((entry) => ({
    params: { locatie: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Eén plek voor de reviewteller (header-trustregel + voorstelblok).
const REVIEWS = 24;

const pageUrl = canonicalUrl(`/${entry.id}/`);
const breadcrumbs = [
  { name: 'Home', item: site.url },
  { name: entry.data.title },
];

const faqs = entry.data.faq ?? [];
const extraSchema = [
  buildLocalBusinessPiece(),
  ...(faqs.length > 0 ? [buildFaqPiece(pageUrl, faqs)] : []),
];
---

<Page
  title={entry.data.title}
  seoTitle={entry.data.seoTitle}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  noindex={entry.data.noindex}
  breadcrumbs={breadcrumbs}
  extraSchema={extraSchema}
  enAlternate={false}
  altPath="/en/"
>
  <article class="local-page">
    <div class="container">
      <header class="local-header">
        <span class="tag">{entry.data.region}</span>
        <h1>{entry.data.title}</h1>
        <p class="local-description">{entry.data.description}</p>
        <a href="/contact/" class="btn-primary">Plan een gesprek →</a>
        <p class="local-trust">
          <a class="trust-item trust-link" href={site.social.googleBusiness} target="_blank" rel="noopener noreferrer"><span class="trust-star" aria-hidden="true">★</span> 5,0 op Google · {REVIEWS} reviews</a>
          <span class="trust-sep" aria-hidden="true">·</span>
          <a class="trust-item trust-link" href="/blog/google-ads-impact-awards-2026/">Genomineerd voor de Google Ads Impact Awards 2026</a>
        </p>
      </header>

      <div class="local-body">
        <div class="prose">
          <Content />
        </div>
      </div>

      <section class="local-about">
        <div class="about-photo">
          <img src="/images/pand.jpg" alt="Het kantoor van MS618 aan de haven van Joure" width="1276" height="865" loading="lazy" />
        </div>
        <div class="about-text">
          <h2>Even voorstellen</h2>
          <p>MS618 is een digitaal marketing- en AI-bureau in Joure, aan de haven in een oud fabriekspand van Douwe Egberts. Vijf senior specialisten, geen junioren. Hetzelfde team dat 's ochtends aan een campagne voor een <a href="/cases/swoop-seo/">tech-startup in Los Angeles</a> werkt, zit 's middags bij een Friese ondernemer aan tafel.</p>
          <p>Dat is de missie: wat daar al werkt, ook hier laten landen. Zodat een ondernemer in Friesland voorsprong krijgt in plaats van achterstand.</p>
          <p>Eerlijk advies, ook als dat betekent dat je ons niet nodig hebt.</p>
          <p class="about-trust">
            <a href={site.social.googleBusiness} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">★</span> 5,0 op Google · {REVIEWS} reviews</a>
            <span class="about-sep" aria-hidden="true">·</span>
            <a href="/blog/google-ads-impact-awards-2026/">Genomineerd: Google Ads Impact Awards 2026</a>
          </p>
          <a href="/contact/" class="btn-primary about-cta">Plan een gesprek →</a>
        </div>
      </section>

      {faqs.length > 0 && (
        <section class="local-faq">
          <h2>Veelgestelde vragen</h2>
          <div class="faq-list">
            {faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.question}</summary>
                <p>{f.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}
    </div>

    <CTA
      headline={`Marketing in ${entry.data.region} die werkt?`}
      body="Plan een vrijblijvend kennismakingsgesprek. We bespreken eerlijk waar voor jouw bedrijf de meeste groei zit."
    />
  </article>
</Page>

<style>
  .local-page {
    padding-top: 2rem;
  }

  .local-header {
    padding: 3rem 0;
    border-bottom: 1px solid oklch(0.15 0 0);
    margin-bottom: 3rem;
    max-width: 760px;
  }

  .local-header .tag {
    display: inline-block;
    margin-bottom: 1.25rem;
  }

  .local-header h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: oklch(0.98 0 0);
    margin-bottom: 1rem;
  }

  .local-description {
    font-size: 1.125rem;
    color: oklch(0.68 0 0);
    line-height: 1.7;
    margin-bottom: 1.75rem;
    max-width: 620px;
  }

  .local-trust {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: oklch(0.68 0 0);
  }

  .trust-star {
    color: oklch(0.8 0.09 90);
  }

  .trust-sep {
    color: oklch(0.4 0 0);
  }

  .trust-link {
    color: oklch(0.68 0 0);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .trust-link:hover {
    color: oklch(0.92 0 0);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .local-body {
    padding-bottom: 4rem;
    border-bottom: 1px solid oklch(0.15 0 0);
  }

  /* ── Even voorstellen: menselijk bewijs op elke regiopagina ── */
  .local-about {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 2.5rem;
    align-items: center;
    margin-top: 4rem;
    padding: 2rem;
    border: 1px solid oklch(0.18 0 0);
    background: oklch(0.11 0 0);
  }

  .about-photo img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 240px;
    object-fit: cover;
    filter: brightness(0.95);
  }

  .about-text h2 {
    font-size: 1.125rem;
    font-weight: 600;
    color: oklch(0.98 0 0);
    margin-bottom: 0.85rem;
  }

  .about-text p {
    font-size: 0.9375rem;
    color: oklch(0.68 0 0);
    line-height: 1.7;
    margin-bottom: 0.85rem;
  }

  .about-text p a {
    color: oklch(0.85 0 0);
    text-decoration: none;
    border-bottom: 1px solid oklch(0.35 0 0);
    padding-bottom: 1px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .about-text p a:hover {
    color: oklch(0.98 0 0);
    border-color: oklch(0.7 0 0);
  }

  .about-trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.25rem;
    margin-bottom: 0 !important;
    font-size: 0.8125rem;
  }

  .about-trust a {
    color: oklch(0.72 0 0);
    text-decoration: none;
    border-bottom: 1px solid oklch(0.28 0 0);
    padding-bottom: 1px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .about-trust a:hover {
    color: oklch(0.98 0 0);
    border-color: oklch(0.6 0 0);
  }

  .about-sep {
    color: oklch(0.35 0 0);
  }

  .about-cta {
    display: inline-block;
    margin-top: 1.4rem;
  }

  @media (max-width: 768px) {
    .local-about {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 1.5rem;
    }

    .about-photo img {
      max-height: 180px;
    }
  }

  .local-faq {
    padding: 4rem 0;
    max-width: 760px;
  }

  .local-faq h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: oklch(0.98 0 0);
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    border-top: 1px solid oklch(0.18 0 0);
  }

  .faq-item:last-child {
    border-bottom: 1px solid oklch(0.18 0 0);
  }

  .faq-item summary {
    cursor: pointer;
    list-style: none;
    padding: 1.25rem 2rem 1.25rem 0;
    font-size: 1.0625rem;
    font-weight: 500;
    color: oklch(0.95 0 0);
    position: relative;
    transition: color 0.2s ease;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.5rem;
    font-weight: 300;
    color: oklch(0.6 0 0);
    transition: transform 0.2s ease;
  }

  .faq-item[open] summary::after {
    transform: translateY(-50%) rotate(45deg);
  }

  .faq-item summary:hover {
    color: oklch(0.65 0.2 250);
  }

  .faq-item p {
    margin: 0;
    padding: 0 0 1.5rem;
    color: oklch(0.68 0 0);
    line-height: 1.7;
    font-size: 0.9688rem;
  }
</style>
